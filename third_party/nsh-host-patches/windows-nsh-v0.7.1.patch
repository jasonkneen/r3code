+struct SvgOutline {
+    d: String,
+    x: f32,
+    y: f32,
+    scale: f32,
+}
+
+impl ttf_parser::OutlineBuilder for SvgOutline {
+    fn move_to(&mut self, x: f32, y: f32) {
+        use std::fmt::Write;
+        let _ = write!(self.d, "M{:.2} {:.2}", self.x + x * self.scale, self.y - y * self.scale);
+    }
+
+    fn line_to(&mut self, x: f32, y: f32) {
+        use std::fmt::Write;
+        let _ = write!(self.d, "L{:.2} {:.2}", self.x + x * self.scale, self.y - y * self.scale);
+    }
+
+    fn quad_to(&mut self, x1: f32, y1: f32, x: f32, y: f32) {
+        use std::fmt::Write;
+        let _ = write!(
+            self.d,
+            "Q{:.2} {:.2} {:.2} {:.2}",
+            self.x + x1 * self.scale,
+            self.y - y1 * self.scale,
+            self.x + x * self.scale,
+            self.y - y * self.scale,
+        );
+    }
+
+    fn curve_to(&mut self, x1: f32, y1: f32, x2: f32, y2: f32, x: f32, y: f32) {
+        use std::fmt::Write;
+        let _ = write!(
+            self.d,
+            "C{:.2} {:.2} {:.2} {:.2} {:.2} {:.2}",
+            self.x + x1 * self.scale,
+            self.y - y1 * self.scale,
+            self.x + x2 * self.scale,
+            self.y - y2 * self.scale,
+            self.x + x * self.scale,
+            self.y - y * self.scale,
+        );
+    }
+
+    fn close(&mut self) {
+        self.d.push('Z');
+    }
+}
+
+fn svg_paint(color: &TexColor) -> String {
+    if *color == TexColor::BLACK {
+        "currentColor".to_owned()
+    } else {
+        format!(
+            "rgba({},{},{},{:.3})",
+            (color.r.clamp(0.0, 1.0) * 255.0).round() as u8,
+            (color.g.clamp(0.0, 1.0) * 255.0).round() as u8,
+            (color.b.clamp(0.0, 1.0) * 255.0).round() as u8,
+            color.a.clamp(0.0, 1.0),
+        )
+    }
+}
+
+/// Typesets TeX math into a standalone SVG using RaTeX and the embedded KaTeX fonts.
+pub fn r3_tex_to_svg(tex: &str, display: bool) -> Option<String> {
+    use std::fmt::Write;
+    let formula = typeset(tex, display)?;
+    let list = &formula.list;
+    let size = 16.0_f32;
+    let pt = |v: f64| v as f32 * size;
+    let above = list.height + OVERSHOOT;
+    let below = list.depth + OVERSHOOT;
+    let w_ex = (list.width * 2.0).max(0.01);
+    let h_ex = ((above + below) * 2.0).max(0.01);
+    let d_ex = below * 2.0;
+    let w_px = (list.width as f32 * size).max(0.5);
+    let h_px = ((above + below) as f32 * size).max(0.5);
+    let top = (above - list.height) as f32 * size;
+
+    let mut body = String::new();
+    for item in &list.items {
+        match item {
+            DisplayItem::GlyphPath {
+                x,
+                y,
+                scale,
+                font,
+                char_code,
+                color,
+            } => {
+                let Some(f) = face(font) else {
+                    continue;
+                };
+                let id = FontId::parse(font).unwrap_or(FontId::MainRegular);
+                let ch = ratex_font::katex_ttf_glyph_char(id, *char_code);
+                let Some(glyph) = f.glyph_index(ch) else {
+                    continue;
+                };
+                let units = f32::from(f.units_per_em());
+                let mut outline = SvgOutline {
+                    d: String::new(),
+                    x: pt(*x),
+                    y: top + pt(*y),
+                    scale: size * *scale as f32 / units,
+                };
+                f.outline_glyph(glyph, &mut outline);
+                if !outline.d.is_empty() {
+                    let _ = write!(body, "<path d=\"{}\" fill=\"{}\"/>", outline.d, svg_paint(color));
+                }
+            }
+            DisplayItem::Line {
+                x,
+                y,
+                width,
+                thickness,
+                color,
+                ..
+            } => {
+                let t = pt(*thickness).max(1.0);
+                let _ = write!(
+                    body,
+                    "<rect x=\"{:.2}\" y=\"{:.2}\" width=\"{:.2}\" height=\"{:.2}\" fill=\"{}\"/>",
+                    pt(*x),
+                    top + pt(*y) - t / 2.0,
+                    pt(*width),
+                    t,
+                    svg_paint(color),
+                );
+            }
+            DisplayItem::Rect {
+                x,
+                y,
+                width,
+                height,
+                color,
+            } => {
+                let _ = write!(
+                    body,
+                    "<rect x=\"{:.2}\" y=\"{:.2}\" width=\"{:.2}\" height=\"{:.2}\" fill=\"{}\"/>",
+                    pt(*x),
+                    top + pt(*y),
+                    pt(*width),
+                    pt(*height),
+                    svg_paint(color),
+                );
+            }
+            DisplayItem::Path {
+                x,
+                y,
+                commands,
+                fill,
+                color,
+            } => {
+                let ox = pt(*x);
+                let oy = top + pt(*y);
+                let mut d = String::new();
+                for c in commands {
+                    match *c {
+                        PathCommand::MoveTo { x, y } => {
+                            let _ = write!(d, "M{:.2} {:.2}", ox + pt(x), oy + pt(y));
+                        }
+                        PathCommand::LineTo { x, y } => {
+                            let _ = write!(d, "L{:.2} {:.2}", ox + pt(x), oy + pt(y));
+                        }
+                        PathCommand::QuadTo { x1, y1, x, y } => {
+                            let _ = write!(
+                                d,
+                                "Q{:.2} {:.2} {:.2} {:.2}",
+                                ox + pt(x1),
+                                oy + pt(y1),
+                                ox + pt(x),
+                                oy + pt(y),
+                            );
+                        }
+                        PathCommand::CubicTo {
+                            x1,
+                            y1,
+                            x2,
+                            y2,
+                            x,
+                            y,
+                        } => {
+                            let _ = write!(
+                                d,
+                                "C{:.2} {:.2} {:.2} {:.2} {:.2} {:.2}",
+                                ox + pt(x1),
+                                oy + pt(y1),
+                                ox + pt(x2),
+                                oy + pt(y2),
+                                ox + pt(x),
+                                oy + pt(y),
+                            );
+                        }
+                        PathCommand::Close => d.push('Z'),
+                    }
+                }
+                if !d.is_empty() {
+                    if *fill {
+                        let _ = write!(body, "<path d=\"{d}\" fill=\"{}\"/>", svg_paint(color));
+                    } else {
+                        let _ = write!(
+                            body,
+                            "<path d=\"{d}\" fill=\"none\" stroke=\"{}\" stroke-width=\"{:.2}\"/>",
+                            svg_paint(color),
+                            (size * 0.04).max(1.0),
+                        );
+                    }
+                }
+            }
+        }
+    }
+
+    Some(format!(
+        "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{w_ex:.3}ex\" height=\"{h_ex:.3}ex\" style=\"vertical-align: -{d_ex:.3}ex\" viewBox=\"0 0 {w_px:.2} {h_px:.2}\">{body}</svg>"
+    ))
+}
