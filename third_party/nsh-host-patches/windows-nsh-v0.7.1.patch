+                    .join("data")
+                    .join("nativeDependencyNotices.json");
+                let text = fs::read_to_string(&path)
+                    .map_err(|err| format!("Could not read native dependency notices: {err}"))?;
+                let value: Value = serde_json::from_str(&text)
+                    .map_err(|err| format!("Invalid native dependency notices JSON: {err}"))?;
+                let valid = value.get("texts").is_some_and(Value::is_array)
+                    && value.get("packages").is_some_and(Value::is_array);
+                if !valid {
+                    return Err("Native dependency notices have an invalid shape.".to_owned());
+                }
+                Ok(value)
+            })();
+            if let Ok(mut slot) = job_reply.lock()
+                && let Some(r) = slot.take()
+            {
+                r.reply(response);
+            }
+        }))
+        .is_err()
+            && let Ok(mut slot) = reply.lock()
+            && let Some(r) = slot.take()
+        {
+            r.reply(Err("Native license worker queue is saturated.".to_owned()));
+        }
+    });
+
+    host.handle("r3.readClerkClientToken", move |call| {
+        let raw_url = call
+            .data()
+            .get("url")
+            .and_then(Value::as_str)
+            .unwrap_or("https://clerk.t3.codes/");
+        let url = if raw_url == "https://clerk.t3.codes" || raw_url == "https://clerk.t3.codes/" {
+            "https://clerk.t3.codes/".to_owned()
+        } else {
+            call.reject("r3.readClerkClientToken only permits the T3 Connect Clerk origin.");
+            return;
+        };
+        let Some(reply) = call.into_reply() else {
+            return;
+        };
+        ui.invoke(move || {
+            crate::native::read_clerk_client_cookie(&url, move |token| {
+                reply.reply(Ok(token.map_or(Value::Null, Value::String)));
+            });
+        });
+    });
+}
