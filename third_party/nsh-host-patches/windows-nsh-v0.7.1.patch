+#[cfg(feature = "highlight")]
+fn r3_token_colors(token: Option<Token>) -> (Option<&'static str>, Option<&'static str>, u8) {
+    match token {
+        Some(Token::Comment) => (Some("#6e7781"), Some("#7d7a72"), 1),
+        Some(Token::Keyword) => (Some("#8250df"), Some("#c4a7ff"), 0),
+        Some(Token::String) => (Some("#116329"), Some("#9fd68a"), 0),
+        Some(Token::Number) => (Some("#953800"), Some("#f5b27a"), 0),
+        Some(Token::Title) => (Some("#0550ae"), Some("#82b8ff"), 0),
+        Some(Token::Attr) => (Some("#7d4e00"), Some("#f0c674"), 0),
+        Some(Token::Built) => (Some("#0a7285"), Some("#6fd3d8"), 0),
+        Some(Token::Deletion) => (Some("#cf222e"), Some("#f87171"), 0),
+        Some(Token::Bold) => (None, None, 2),
+        Some(Token::Italic) => (None, None, 1),
+        None | Some(Token::Operator) | Some(Token::Storage) => (None, None, 0),
+    }
+}
+
+/// Highlights `code` in `language` into line spans of `(text, light_hex, dark_hex, style_mask)`.
+#[cfg(feature = "highlight")]
+pub fn r3_highlight_lines(
+    language: &str,
+    code: &str,
+) -> Option<Vec<Vec<(String, Option<&'static str>, Option<&'static str>, u8)>>> {
+    let syntax = find_syntax(language)?;
+    let set = syntaxes();
+    let mut parse = Parse::new(syntax);
+    let mut out = Vec::new();
+    let mut with_nl = String::new();
+    for raw_line in code.split('\n') {
+        with_nl.clear();
+        with_nl.push_str(raw_line);
+        with_nl.push('\n');
+        let mut spans: Vec<(String, Option<&'static str>, Option<&'static str>, u8)> = Vec::new();
+        let Parse { state, scopes } = &mut parse;
+        if let Ok(ops) = state.parse_line(&with_nl, set) {
+            let mut at = 0usize;
+            for (offset, op) in ops {
+                let end = offset.min(raw_line.len());
+                if end > at {
+                    let piece = &raw_line[at..end];
+                    let (light, dark, style) = r3_token_colors(scope_token(scopes, piece));
+                    if let Some(last) = spans.last_mut()
+                        && last.1 == light
+                        && last.2 == dark
+                        && last.3 == style
+                    {
+                        last.0.push_str(piece);
+                    } else {
+                        spans.push((piece.to_owned(), light, dark, style));
+                    }
+                    at = end;
+                }
+                let _ = scopes.apply(&op);
+            }
+            if at < raw_line.len() {
+                let piece = &raw_line[at..];
+                let (light, dark, style) = r3_token_colors(scope_token(scopes, piece));
+                if let Some(last) = spans.last_mut()
+                    && last.1 == light
+                    && last.2 == dark
+                    && last.3 == style
+                {
+                    last.0.push_str(piece);
+                } else {
+                    spans.push((piece.to_owned(), light, dark, style));
+                }
+            }
+        } else if !raw_line.is_empty() {
+            spans.push((raw_line.to_owned(), None, None, 0));
+        }
+        out.push(spans);
+    }
+    Some(out)
+}
