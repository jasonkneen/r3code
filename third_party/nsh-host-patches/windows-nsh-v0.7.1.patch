+type RenderJob = Box<dyn FnOnce() + Send>;
+
+const RENDER_POOL_WORKERS: usize = 2;
+const RENDER_POOL_QUEUE: usize = 64;
+
+fn render_pool() -> &'static mpsc::SyncSender<RenderJob> {
+    static POOL: OnceLock<mpsc::SyncSender<RenderJob>> = OnceLock::new();
+    POOL.get_or_init(|| {
+        let (tx, rx) = mpsc::sync_channel::<RenderJob>(RENDER_POOL_QUEUE);
+        let shared = Arc::new(Mutex::new(rx));
+        for idx in 0..RENDER_POOL_WORKERS {
+            let rx = Arc::clone(&shared);
+            let _ = std::thread::Builder::new()
+                .name(format!("r3-worker-{idx}"))
+                .spawn(move || loop {
+                    let job = {
+                        let Ok(guard) = rx.lock() else { break };
+                        guard.recv()
+                    };
+                    match job {
+                        Ok(run) => run(),
+                        Err(_) => break,
+                    }
+                });
+        }
+        tx
+    })
+}
+
+fn try_enqueue_render_job(job: RenderJob) -> Result<(), RenderJob> {
+    match render_pool().try_send(job) {
+        Ok(()) => Ok(()),
+        Err(mpsc::TrySendError::Full(job) | mpsc::TrySendError::Disconnected(job)) => Err(job),
+    }
+}
