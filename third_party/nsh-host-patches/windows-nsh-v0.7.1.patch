+//! R3 Code desktop host handlers on Windows: live theme overrides, WebView2
+//! layering/focus capabilities, DPAPI-backed secure storage, and native file/folder
+//! dialogs.
+
+use std::{
+    collections::{HashMap, HashSet},
+    ffi::c_void,
+    fs,
+    path::{Path, PathBuf},
+    sync::{
+        Arc, Mutex, OnceLock,
