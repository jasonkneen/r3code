+struct RpcSchemaCatalog {
+    methods: HashMap<String, Value>,
+    definitions: HashMap<String, Value>,
+}
+
+static RPC_SCHEMA_CATALOG: Mutex<Option<Arc<RpcSchemaCatalog>>> = Mutex::new(None);
+
+fn load_rpc_schema_catalog() -> Result<Arc<RpcSchemaCatalog>, String> {
+    if let Ok(guard) = RPC_SCHEMA_CATALOG.lock()
+        && let Some(existing) = guard.as_ref()
+    {
+        return Ok(Arc::clone(existing));
+    }
+    let path = std::env::current_exe()
+        .map_err(|err| format!("Could not resolve executable path: {err}"))?
+        .parent()
+        .ok_or_else(|| "Executable has no parent directory".to_owned())?
+        .join("nsh")
+        .join("assets")
+        .join("data")
+        .join("rpcResultSchemas.json");
+    let text = fs::read_to_string(&path)
+        .map_err(|err| format!("Could not read RPC result schemas: {err}"))?;
+    let root: Value = serde_json::from_str(&text)
+        .map_err(|err| format!("Invalid RPC result schema JSON: {err}"))?;
+    let methods = root
+        .get("methods")
+        .and_then(Value::as_object)
+        .ok_or_else(|| "RPC result schema catalog is missing methods".to_owned())?
+        .iter()
+        .map(|(k, v)| (k.clone(), v.clone()))
+        .collect::<HashMap<_, _>>();
+    let definitions = root
+        .get("definitions")
+        .and_then(Value::as_object)
+        .ok_or_else(|| "RPC result schema catalog is missing definitions".to_owned())?
+        .iter()
+        .map(|(k, v)| (k.clone(), v.clone()))
+        .collect::<HashMap<_, _>>();
+    let catalog = Arc::new(RpcSchemaCatalog { methods, definitions });
+    if let Ok(mut guard) = RPC_SCHEMA_CATALOG.lock() {
+        *guard = Some(Arc::clone(&catalog));
+    }
+    Ok(catalog)
+}
+
+fn collect_schema_refs(
+    root: &Value,
+    all_defs: &HashMap<String, Value>,
+    out: &mut serde_json::Map<String, Value>,
+) -> Result<(), String> {
+    let mut stack: Vec<&Value> = vec![root];
+    let mut visited_defs: HashSet<String> = HashSet::new();
+    while let Some(node) = stack.pop() {
+        match node {
+            Value::Object(map) => {
+                if let Some(mut raw_ref) = map.get("$ref").and_then(Value::as_str) {
+                    let mut hops = 0usize;
+                    loop {
+                        hops += 1;
+                        if hops > 32 {
+                            return Err("RPC result schema $ref nesting depth exceeded".to_owned());
+                        }
+                        let name = raw_ref
+                            .strip_prefix("#/$defs/")
+                            .or_else(|| raw_ref.strip_prefix("#/definitions/"))
+                            .unwrap_or(raw_ref);
+                        let target = all_defs
+                            .get(name)
+                            .ok_or_else(|| format!("RPC result schema references missing definition: {name}"))?;
+                        if visited_defs.insert(name.to_owned()) {
+                            out.insert(name.to_owned(), target.clone());
+                            stack.push(target);
+                        }
+                        if let Some(next_ref) = target.get("$ref").and_then(Value::as_str) {
+                            raw_ref = next_ref;
+                        } else {
+                            break;
+                        }
+                    }
+                }
+                for child in map.values() {
+                    stack.push(child);
+                }
+            }
+            Value::Array(items) => {
+                for item in items {
+                    stack.push(item);
+                }
+            }
+            _ => {}
+        }
+    }
+    Ok(())
+}
+
+fn rpc_method_schema_response(catalog: &RpcSchemaCatalog, method: &str) -> Result<Value, String> {
+    let Some(schema) = catalog.methods.get(method) else {
+        return Ok(json!({ "found": false }));
+    };
+    let mut defs = serde_json::Map::new();
+    collect_schema_refs(schema, &catalog.definitions, &mut defs)?;
+    Ok(json!({
+        "found": true,
+        "schema": schema,
+        "definitions": Value::Object(defs),
+    }))
+}
